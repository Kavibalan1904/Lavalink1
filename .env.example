# ==============================================================================
# 1. LAVALINK SERVER CONFIGURATION (Render Dashboard -> Environment Variables)
# ==============================================================================
# Server password (defaults to 'youshallnotpass' if not set)
LAVALINK_PASSWORD=youshallnotpass

# JVM flags optimized for Render Free Tier 512MB RAM
JAVA_OPTS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=96m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dfile.encoding=UTF-8

# (Optional) Spotify API Credentials for metadata resolution via LavaSrc plugin
# Get credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=US

# (Optional) YouTube Anti-Bot Bypass Tokens (Proof of Origin Token)
# Generated via https://github.com/iv-org/youtube-trusted-session-generator
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# (Optional) YouTube OAuth refresh token if using Google account sign-in
YOUTUBE_OAUTH_REFRESH_TOKEN=


# ==============================================================================
# 2. BOT CONFIGURATION (Copy these values into your Resobott .env file)
# ==============================================================================
# Replace YOUR-RENDER-SERVICE with your Render Web Service name:
# LAVALINK_HOST=your-app-name.onrender.com
# LAVALINK_PORT=443
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=true
