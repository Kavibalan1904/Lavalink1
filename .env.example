# ==============================================================================
# 1. LAVALINK SERVER CONFIGURATION (Render Dashboard -> Environment Variables)
# ==============================================================================
# Required: generate a long random password and set the same value in Render and Resobott.
LAVALINK_PASSWORD=replace_with_a_long_random_secret

# JVM flags optimized for Render Free Tier 512MB RAM
JAVA_OPTS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=96m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dfile.encoding=UTF-8

# Spotify API credentials required for spsearch / Spotify metadata resolution via LavaSrc.
# YouTube and native SoundCloud search do not require these credentials.
# Get credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=IN

# (Optional) YouTube Anti-Bot Bypass Tokens (Proof of Origin Token)
# Generated via https://github.com/iv-org/youtube-trusted-session-generator
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# (Recommended) YouTube OAuth Authentication (Fixes "This video requires login")
# 1. Start server with empty YOUTUBE_OAUTH_REFRESH_TOKEN and YOUTUBE_OAUTH_SKIP_INIT=false
# 2. Check Render logs for pairing URL (https://www.google.com/device) and code
# 3. Enter code with a burner Google account, then paste the generated refresh token below
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INIT=false


# ==============================================================================
# 2. BOT CONFIGURATION (Copy these values into your Resobott .env file)
# ==============================================================================
# Replace YOUR-RENDER-SERVICE with your Render Web Service name:
# LAVALINK_HOST=your-app-name.onrender.com
# LAVALINK_PORT=443
# LAVALINK_PASSWORD=<your-long-random-secret>
# LAVALINK_SECURE=true
